# Generation-side OpenRouter key. Used by the participant proxy.
# This key is exposed to the proxy only and must enforce
# - model == google/gemma-4-31b-it
# - no :online, plugins[web].enabled = false, no tools, no server tools
OPENROUTER_KEY=

# Judge-side OpenRouter key. Independent billing/account from OPENROUTER_KEY.
# Allowed to use latest LLMs (Claude, GPT, Gemini) with :online / web_search
# server tools for contamination audit. NEVER expose to participant containers.
OPENROUTER_JUDGE_KEY=

# MinerU v4 API key. Only used during corpus build and target-paper parsing.
# Never mounted into participant containers.
MINERU_KEY=

# Optional: pin a specific provider slug for the generation model so
# OpenRouter does not load-balance across providers for reproducibility.
GEMMA_PROVIDER_SLUG=

# Where the proxy writes audit logs (JSONL).
PROXY_AUDIT_DIR=./proxy/audit_logs

# Canary report output directory.
CANARY_REPORT_DIR=./reports/canary
