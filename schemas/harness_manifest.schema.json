{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dirtycomputer/wanghong_leaderboard/schemas/harness_manifest.schema.json",
  "title": "harness.yaml",
  "description": "Metadata for a self-contained harness directory under harnesses/<name>. The official runner validates this before spending a token.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "kind", "image", "entrypoint", "resources", "capabilities", "outputs"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "version": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Harness runtime family, e.g. model, model_rag, codex, claude_code."
    },
    "image": {
      "type": "string",
      "pattern": "^[^@]+@sha256:[0-9a-f]{64}$",
      "description": "Immutable Docker image reference used to run this harness."
    },
    "license": { "type": "string", "minLength": 1 },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "affiliation": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      }
    },
    "entrypoint": {
      "type": "string",
      "const": "./run.sh",
      "description": "Shell command relative to the mounted /harness directory. It performs the task and writes the required outputs."
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_wall_time_hours", "max_model_calls", "max_total_tokens", "cpu", "memory_gb"],
      "properties": {
        "max_wall_time_hours": { "type": "number", "minimum": 0.1, "maximum": 48 },
        "max_model_calls": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "max_total_tokens": { "type": "integer", "minimum": 1, "maximum": 50000000 },
        "cpu": { "type": "integer", "minimum": 1, "maximum": 64 },
        "memory_gb": { "type": "integer", "minimum": 1, "maximum": 256 },
        "gpu": { "type": "boolean", "default": false }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "restricted_search", "native_tools"],
      "properties": {
        "model": {
          "type": "boolean",
          "description": "Whether the runner should expose MODEL_API_* environment variables."
        },
        "restricted_search": {
          "type": "boolean",
          "description": "Whether the runner should expose SEARCH_API_* environment variables."
        },
        "native_tools": {
          "type": "boolean",
          "const": false,
          "description": "Must be false. Agent-native web/search/tooling is disabled; use restricted_search instead."
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_proof", "proof_graph", "citations", "self_critique", "trace"],
      "properties": {
        "final_proof": { "type": "string", "const": "final_proof.md" },
        "proof_graph": { "type": "string", "const": "proof_graph.json" },
        "citations": { "type": "string", "const": "cited_sources.json" },
        "self_critique": { "type": "string", "const": "self_critique.md" },
        "trace": { "type": "string", "const": "trace.jsonl" }
      }
    }
  }
}
