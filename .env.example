# Model proxy and Codex/OpenRouter harness.
OPENROUTER_KEY=

# Judge models. Do not expose this to harnesses.
OPENROUTER_JUDGE_KEY=

# Restricted Exa search. Leave empty if you are not running search yet.
EXA_API_KEY=
RESTRICTED_SEARCH_CUTOFF=2025-01-01T00:00:00Z
RESTRICTED_SEARCH_TOKEN=
SEARCH_API_BASE=http://127.0.0.1:8088
SEARCH_API_KEY=

# Optional provider pin for reproducible OpenRouter runs.
GEMMA_PROVIDER_SLUG=

# Local logs.
PROXY_AUDIT_DIR=./proxy/audit_logs
